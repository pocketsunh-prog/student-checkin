# Copy to .env.local for local development.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time,
# so rebuilding is required after changing this value.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Same-origin proxy used by Android kiosks at /api/* on port 3000.
# Docker Compose sets this to http://backend:3001 automatically.
API_PROXY_TARGET=http://localhost:3001

# Optional: used by `next dev`/`next start` (defaults to 3000).
# PORT=3000
