# Copy to backend/.env for local development on Node 24 (no native tfjs-node).
# Docker compose supplies its own environment and runs FACE_PROVIDER=human.

# Docker MySQL from docker-compose.yml uses host port 3307.
DATABASE_URL="mysql://checkin:checkinpass@127.0.0.1:3307/checkin"
# Dedicated database for `npm test` (create it once, see README).
TEST_DATABASE_URL="mysql://checkin:checkinpass@127.0.0.1:3307/checkin_test"

NODE_ENV=development
PORT=3001
JWT_SECRET="local-dev-jwt-secret-change-me-at-least-32-characters"
JWT_EXPIRES_IN=12h
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
PUBLIC_BASE_URL="http://localhost:3001"

# Face recognition: mock locally (no TensorFlow); human in Docker.
FACE_PROVIDER=mock
FACE_MODEL_PATH="./models"
FACE_MATCH_THRESHOLD=0.60
FACE_MIN_CONFIDENCE=0.5
FACE_MAX_IMAGE_BYTES=8388608

STORAGE_DIR="./storage"
SAVE_SCAN_IMAGES=false
MAX_UPLOAD_MB=8
RATE_LIMIT_DISABLED=false
LOG_LEVEL=info

SEED_ADMIN_EMAIL=admin@school.edu
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME="School Administrator"
SEED_DEVICE_NAME="Demo Kiosk"
SEED_DEVICE_LOCATION="Main Entrance"
SEED_DEVICE_KEY=demo-kiosk-key-12345
SEED_DEMO_STUDENTS=true
