# ===== Copy to .env for local development =====
# Docker MySQL (host port 3307 avoids clashing with a local MySQL)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=checkin
MYSQL_USER=checkin
MYSQL_PASSWORD=checkinpass
MYSQL_PORT=3307

# Backend (host dev uses 127.0.0.1:3307; docker compose overrides to mysql:3306)
NODE_ENV=development
PORT=3001
DATABASE_URL="mysql://checkin:checkinpass@127.0.0.1:3307/checkin"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=12h
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
PUBLIC_BASE_URL="http://localhost:3001"

# Face recognition: human (production) or mock (tests/local without TFJS)
FACE_PROVIDER=human
FACE_MODEL_PATH="./models"
FACE_MATCH_THRESHOLD=0.60
FACE_MIN_CONFIDENCE=0.5
FACE_MAX_IMAGE_BYTES=8388608

# Storage
STORAGE_DIR="./storage"
SAVE_SCAN_IMAGES=false
MAX_UPLOAD_MB=8

# Seed / demo data
SEED_ADMIN_EMAIL=admin@school.edu
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME="School Administrator"
SEED_DEVICE_NAME="Demo Kiosk"
SEED_DEVICE_LOCATION="Main Entrance"
SEED_DEVICE_KEY=demo-kiosk-key-12345
SEED_DEMO_STUDENTS=true

# Frontend (baked at Next.js build time)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Backend target used by the same-origin /api/* proxy on port 3000 (Android kiosk URL)
API_PROXY_TARGET=http://backend:3001
