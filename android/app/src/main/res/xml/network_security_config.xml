<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-only network policy: the kiosk talks to the school demo server over plain
  HTTP on the LAN (e.g. http://192.168.1.20:3001/api), and the emulator uses
  http://10.0.2.2:3001/api. Cleartext is therefore permitted app-wide.

  BEFORE ANY REAL DEPLOYMENT: serve the API over HTTPS and set
  cleartextTrafficPermitted="false" here (or restrict the base-config to the
  debug build type only). See android/README.md, "Security notes".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
